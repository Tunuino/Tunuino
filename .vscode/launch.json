{
  "version": "0.2.0",
  "configurations": [{
    "name": "Tunuino simulator",
    "type": "cppdbg",
    "request": "launch",
    "program": "${workspaceFolder}/build/simulator/tunuino-simulator",
    "windows": {"program": "${workspaceFolder}/build/simulator/tunuino-simulator.exe"},
    "args": ["--stdio", "--family", "proteus"],
    "cwd": "${workspaceFolder}",
    "MIMode": "gdb",
    "externalConsole": true,
    "preLaunchTask": "Tunuino: build simulator"
  }]
}
